{
  "name": "flashcard",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --port 4333 --proxy-config proxy.conf.json",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "api:build": "pnpm --dir server build",
    "api:start": "pnpm --dir server start",
    "api:test": "pnpm --dir server test",
    "db:backup": "mkdir -p backups && docker compose exec -T postgres pg_dump -U recall -Fc recall > backups/recall-$(date -u +%Y%m%dT%H%M%SZ).dump",
    "db:up": "docker compose up -d --wait",
    "db:migrate-sqlite": "pnpm --dir server migrate:sqlite"
  },
  "private": true,
  "packageManager": "pnpm@10.15.0",
  "dependencies": {
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "@angular/router": "^22.0.0",
    "@angular/service-worker": "^22.2.2",
    "marked": "^18.0.5",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.0.0",
    "@angular/cli": "^22.0.0",
    "@angular/compiler-cli": "^22.0.0",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "esbuild",
      "lmdb",
      "msgpackr-extract"
    ]
  }
}
