# Local API settings (copy to server/.env). Start Postgres and Redis with `docker compose up -d`.
DATABASE_URL=postgres://recall:recall-local@127.0.0.1:5433/recall
REDIS_URL=redis://127.0.0.1:16379
TTS_URL=http://127.0.0.1:20128/v1/audio/speech
TTS_MODEL=edge-tts/en-AU-WilliamMultilingualNeural
TTS_API_KEY=REPLACE_WITH_YOUR_9ROUTER_KEY
AI_URL=http://127.0.0.1:20128/v1/chat/completions
AI_MODEL=zaban

# Public HTTPS origin for MCP OAuth discovery (defaults to first APP_ORIGINS entry).
# MCP_PUBLIC_URL=https://poshtetgarm.ir
# Optional exact OAuth callback hosts, comma-separated; defaults shown.
# MCP_REDIRECT_HOSTS=chatgpt.com,chat.openai.com

# Email (password reset links and notices). Without SMTP_URL, emails are printed to the API log.
# SMTP_URL=smtps://USER:PASSWORD@smtp.example.com:465
# MAIL_FROM=Recall <no-reply@example.com>
# APP_PUBLIC_URL=http://localhost:4333
