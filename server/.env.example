# Local API settings (copy to server/.env). Start Postgres and Redis with `docker compose up -d`.
DATABASE_URL=postgres://recall:recall-local@127.0.0.1:5433/recall
REDIS_URL=redis://127.0.0.1:16379
TTS_URL=http://127.0.0.1:20128/v1/audio/speech
TTS_MODEL=edge-tts/en-AU-WilliamMultilingualNeural
TTS_API_KEY=REPLACE_WITH_YOUR_9ROUTER_KEY
AI_URL=http://127.0.0.1:20128/v1/chat/completions
AI_MODEL=zaban
