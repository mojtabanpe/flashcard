{
  "name": "recall-api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "node --env-file-if-exists=.env dist/server/src/main.js",
    "test": "pnpm build && node --env-file-if-exists=.env.test --test --test-concurrency=1 test/*.test.cjs",
    "migrate:sqlite": "pnpm build && node --env-file-if-exists=.env dist/server/src/migrate-sqlite.js",
    "clone-user": "pnpm build && node --env-file-if-exists=.env dist/server/src/clone-user.js",
    "set-password": "pnpm build && node --env-file-if-exists=.env dist/server/src/set-password.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@nestjs/common": "12.1.3",
    "@nestjs/core": "12.1.3",
    "@nestjs/platform-express": "12.1.3",
    "@nestjs/throttler": "6.7.1",
    "bcryptjs": "3.0.3",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "nodemailer": "10.2.1",
    "pg": "^8.23.1",
    "redis": "6.3.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.8",
    "@types/express": "5.0.6",
    "@types/node": "24.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "typescript": "6.0.2"
  }
}
