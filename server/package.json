{
  "name": "recall-api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "node --env-file-if-exists=.env dist/server/src/main.js",
    "test": "pnpm build && node --test test/*.test.cjs",
    "migrate:import": "pnpm build && node dist/server/src/import.js",
    "backup": "pnpm build && node dist/server/src/backup.js"
  },
  "dependencies": {
    "@nestjs/common": "12.1.3",
    "@nestjs/core": "12.1.3",
    "@nestjs/platform-express": "12.1.3",
    "@nestjs/throttler": "6.7.1",
    "bcryptjs": "3.0.3",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "redis": "6.3.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.8",
    "@types/express": "5.0.6",
    "@types/node": "24.0.0",
    "typescript": "6.0.2"
  }
}
