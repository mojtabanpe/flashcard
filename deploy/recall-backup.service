[Unit]
Description=Consistent Postgres backup for Recall
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
ExecStart=/bin/sh -c 'set -e; f=/opt/recall/backups/daily-$(date -u +%%Y%%m%%dT%%H%%M%%SZ).dump; /usr/bin/docker exec recall-postgres-1 pg_dump -U recall -Fc recall > "$f.tmp"; mv "$f.tmp" "$f"'
UMask=0077
