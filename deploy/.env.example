APP_DOMAIN=poshtetgarm.ir
TTS_URL=http://127.0.0.1:20128/v1/audio/speech
TTS_MODEL=edge-tts/en-US-MichelleNeural
TTS_SECONDARY_MODEL=edge-tts/en-US-EricNeural
TTS_API_KEY=REPLACE_WITH_YOUR_SERVER_TTS_KEY
SIGNUP_ENABLED=false
TTS_CACHE_TTL_SECONDS=86400
# AI card answers via 9Router chat completions (key defaults to TTS_API_KEY)
AI_URL=http://127.0.0.1:20128/v1/chat/completions
AI_MODEL=zaban
# AI_API_KEY=
# Hex only (used inside DATABASE_URL): openssl rand -hex 24
POSTGRES_PASSWORD=REPLACE_WITH_HEX_PASSWORD

# Public HTTPS origin for MCP OAuth discovery (defaults to first APP_ORIGINS entry).
# MCP_PUBLIC_URL=https://poshtetgarm.ir
# Optional exact OAuth callback hosts, comma-separated; defaults shown.
# MCP_REDIRECT_HOSTS=chatgpt.com,chat.openai.com

# Email for password reset links and password-change notices (SMTP URL, credentials URL-encoded).
# Without it, "Forgot password" is unavailable in production.
# SMTP_URL=smtps://USER:PASSWORD@smtp.example.com:465
# MAIL_FROM=Recall <no-reply@poshtetgarm.ir>
# Origin used in emailed links (defaults to first APP_ORIGINS entry).
# APP_PUBLIC_URL=https://poshtetgarm.ir
